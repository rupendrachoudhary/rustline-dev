{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rustline.dev bundled vulnerability snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "libraries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "sha256", "license", "notice"],
      "properties": {
        "name": { "const": "Retire.js" }, "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "const": "Apache-2.0" }, "notice": { "type": "string" }
      }
    },
    "libraries": {
      "type": "object", "minProperties": 15, "maxProperties": 15,
      "required": ["jquery", "angularjs", "react", "react-dom", "vue", "lodash", "underscore", "moment", "bootstrap", "backbone", "handlebars", "axios", "d3", "chartjs", "dompurify"],
      "additionalProperties": { "$ref": "#/$defs/library" }
    }
  },
  "$defs": {
    "library": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "npm", "upstreamKey", "coverage", "latest", "releaseSource", "advisories"],
      "properties": {
        "name": { "type": "string" }, "npm": { "type": "string" }, "upstreamKey": { "type": "string" },
        "coverage": { "enum": ["retire", "unavailable"] }, "latest": { "type": ["string", "null"] },
        "releaseSource": { "type": "string", "format": "uri" },
        "advisories": { "type": "array", "items": { "$ref": "#/$defs/advisory" } }
      }
    },
    "advisory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "aliases", "kind", "severity", "summary", "why", "cwe", "applicability", "references", "ranges"],
      "properties": {
        "id": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" } },
        "kind": { "enum": ["vulnerability", "maintenance"] },
        "severity": { "enum": ["unknown", "low", "medium", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 },
        "cwe": { "type": "array", "items": { "type": "string" } },
        "applicability": { "enum": ["unspecified", "server"] },
        "references": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
        "ranges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/range" } }
      }
    },
    "range": {
      "description": "Union of intervals: introduced inclusive, fixed exclusive. Null means no bound on that side; both cannot be null.",
      "type": "object", "additionalProperties": false, "required": ["introduced", "fixed"],
      "properties": { "introduced": { "type": ["string", "null"] }, "fixed": { "type": ["string", "null"] } },
      "not": { "properties": { "introduced": { "const": null }, "fixed": { "const": null } } }
    }
  }
}
